# Site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://paulacademy.net

# Email notifications via Resend (https://resend.com)
# 1. Create account at resend.com
# 2. Verify your sending domain (paulacademy.net)
# 3. Generate API key and paste below
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Admin email to receive consultation notifications
NOTIFICATION_EMAIL=admin@paulacademy.net

# Error tracking (add when ready)
# NEXT_PUBLIC_SENTRY_DSN=

# Analytics (add when ready)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
